# Pixhawk serial. Bisa diganti menjadi udpin:0.0.0.0:14550 untuk telemetry UDP.
ASV_MAVLINK=/dev/ttyACM0
ASV_MAVLINK_BAUD=115200

# Jalankan client dari http://IP-BOARD:8000 agar dashboard.js otomatis memakai IP yang sama.
ASV_HTTP_HOST=0.0.0.0
ASV_HTTP_PORT=8766
ASV_WS_HOST=0.0.0.0
ASV_WS_PORT=8765
ASV_MISSION_REFRESH_SECONDS=5.0
ASV_MISSION_ITEM_TIMEOUT=1.0
ASV_MISSION_MAX_RETRIES=4
ASV_WAYPOINT_REACHED_RADIUS=1.5
ASV_CAM_ATAS_INDEX=0
ASV_CAM_BAWAH_INDEX=1
