# Koneksi Pixhawk
# Gunakan /dev/serial/by-id/... agar port tidak berubah setelah reboot.
NEO_MAVLINK=/dev/serial/by-id/usb-Holybro_Pixhawk6C_410021001951343034343031-if00
NEO_MAVLINK_BAUD=115200
NEO_MAVLINK_CONTROL_MODE=velocity
NEO_MAVLINK_REQUIRED_MODE=GUIDED
NEO_MAVLINK_HEARTBEAT_TIMEOUT_SECONDS=3.0
NEO_MAVLINK_HEARTBEAT_HZ=1.0

# Port service
NEO_TELEMETRY_WS_PORT=8765
NEO_HTTP_PORT=8766
NEO_TARGET_WS_PORT=8770

# Safety: aktifkan gerak hanya setelah pengujian dry-run selesai.
NEO_AUTO_START=0
NEO_REQUIRE_ARMED=1
NEO_AUTO_SET_GUIDED=0
NEO_ENABLE_REMOTE_COMMANDS=0

# Tuning target dan kontrol
NEO_TARGET_TIMEOUT_SECONDS=0.6
NEO_STOP_DISTANCE_M=2.0
NEO_MAX_FORWARD_MPS=1.5
NEO_DISTANCE_KP=0.45
NEO_HEADING_KP=1.2
NEO_MAX_YAW_RATE_RPS=0.7
NEO_BEARING_DEADBAND_DEGREES=2.0
NEO_DRIVE_BEARING_LIMIT_DEGREES=55.0
